# Naagmani Documentation Portal Environment Configuration

# Base URL for this documentation portal
NEXT_PUBLIC_SITE_URL=https://docs.naagmani.ai
NEXT_PUBLIC_DOCS_URL=https://docs.naagmani.ai

# Base URL for Naagmani Developer Console / Cloud
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=https://cloud.naagmani.ai

# Base URL for Naagmani Cloud Management API (Control Plane)
NEXT_PUBLIC_API_BASE_URL=https://api.naagmani.ai

# Base URL for Naagmani Gateway / Data Plane
NEXT_PUBLIC_GATEWAY_URL=https://gateway.naagmani.ai

# GitHub Repository URL
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/bhakha-services/naagmani-cli
